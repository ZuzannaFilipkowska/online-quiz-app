@page "/quiz/{id}"

@using Grpc.Net.Client
@using QuizApp
@inject NavigationManager NavigationManager


@if (quiz == null)
{
    <p><em>Ładowanie szczegółów quizu...</em></p>
}
else
{
    <div class="quiz-details-questions">
        <h3> Quiz: @quiz.Title</h3>

        <p><strong>Opis:</strong> @quiz.Description</p>

        <div>
                    <h5>Pytania:</h5>
        @if (quiz.Questions.Count == 0)
        {
            <p><em>Brak pytań w tym quizie.</em></p>
        }
        else
        {
<ul >
    @{
        int questionNumber = 1; 
    }
    @foreach (var question in quiz.Questions)
    {
        <li>
            <p><strong>Pytanie @questionNumber:</strong> @question.QuestionText</p>
            <ul>
                @foreach (var answer in question.Answers)
                {
                    <li>
                        @answer.Text
                        @if (answer.IsCorrect)
                        {
                            <span style="color: green;">✔ </span>
                        }
                    </li>
                }
            </ul>
        </li>
        questionNumber++;
    }
</ul>

        }
        </div>

        <button class="create-game-button" @onclick="CreateGame">Utwórz grę</button>
    </div>
}

@code {
    private Quiz quiz;
    [Parameter]
    public string? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Tworzenie kanału gRPC 
            using var channel = Grpc.Net.Client.GrpcChannel.ForAddress("http://localhost:5195/", new Grpc.Net.Client.GrpcChannelOptions
            {
                HttpHandler = new Grpc.Net.Client.Web.GrpcWebHandler(new HttpClientHandler())
            });

            // Tworzenie klienta gRPC
            var client = new QuizService.QuizServiceClient(channel);

            // Pobieranie szczegółów quizu
            var request = new QuizRequest { QuizId = Id };
            var response = await client.GetQuizDetailsAsync(request);

            quiz = response.Quiz;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Błąd podczas ładowania szczegółów quizu: {ex.Message}");
        }
    }

  private async Task CreateGame()
{
    try
    {
       using var channel = Grpc.Net.Client.GrpcChannel.ForAddress("http://localhost:5195/", new Grpc.Net.Client.GrpcChannelOptions
       {
           HttpHandler = new Grpc.Net.Client.Web.GrpcWebHandler(new HttpClientHandler())
       });

       // Tworzenie klienta gRPC
       var client = new QuizService.QuizServiceClient(channel);

        // Call the backend to create a new game
        var createGameRequest = new CreateGameRequest
        {
            QuizId = Id // Assuming `Id` is the Quiz ID for the game
        };

        var response = await client.CreateGameAsync(createGameRequest);

        // Navigate to the new game page with the created game ID
        NavigationManager.NavigateTo($"/games/{response.GameId}");
    }
    catch (Exception ex)
    {
        // Handle any errors from the gRPC call
        Console.WriteLine($"Error creating game: {ex.Message}");
    }

}

}

    <style>
        .create-game-button {
    background-color: #4CAF50;
    color: white;
    padding: 10px 20px;
    border: none;
    cursor: pointer;
    margin-top: 20px;
}

.create-game-button:hover {
    background-color: #45a049;
}

.quiz-details-questions {
    padding: 1rem;
    border-radius: 8px;
    border: 2px solid #c3aeae;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2), 0px 6px 20px rgba(0, 0, 0, 0.19);
}

